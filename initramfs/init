#!/bin/busybox sh
export PATH=/bin:/sbin
BB=/bin/busybox

fail() {
    $BB echo "Kerynth: $1"
    exec $BB sh
}

$BB mkdir -p /proc /sys /dev /media /newroot /lower /overlay
if ! $BB mount -t proc proc /proc; then
    fail "failed to mount /proc."
fi
if ! $BB mount -t sysfs sysfs /sys; then
    fail "failed to mount /sys."
fi
if ! $BB mount -t devtmpfs devtmpfs /dev; then
    fail "failed to mount /dev."
fi

CMDLINE="$($BB cat /proc/cmdline 2>/dev/null)"
if ! BOOT_MODE="$($BB sh /lib/kerynth-boot-mode "$CMDLINE" 2>/dev/null)"; then
    fail "missing, duplicated, or unsupported boot mode."
fi

ROOT=
ROOTFSTYPE=
ROOTFLAGS=
ROOTDELAY=0
MEDIA=
ROOT_SEEN=0
MEDIA_SEEN=0

for item in $CMDLINE; do
    case "$item" in
        root=*)
            ROOT="${item#root=}"
            ROOT_SEEN=$((ROOT_SEEN + 1))
            ;;
        rootfstype=*) ROOTFSTYPE="${item#rootfstype=}" ;;
        rootflags=*) ROOTFLAGS="${item#rootflags=}" ;;
        rootdelay=*) ROOTDELAY="${item#rootdelay=}" ;;
        kerynth.media=*)
            MEDIA="${item#kerynth.media=}"
            MEDIA_SEEN=$((MEDIA_SEEN + 1))
            ;;
    esac
done

case "$ROOTDELAY" in
    ''|*[!0-9]*) ROOTDELAY=0 ;;
esac
if [ "$ROOTDELAY" -gt 30 ]; then
    ROOTDELAY=30
fi

$BB mdev -s 2>/dev/null || true
if [ "$ROOTDELAY" -gt 0 ]; then
    $BB sleep "$ROOTDELAY"
fi

resolve_uuid() {
    wanted_uuid="$1"
    for device in $($BB find /dev -type b 2>/dev/null); do
        metadata="$($BB blkid "$device" 2>/dev/null)"
        case "$metadata" in
            *"UUID=\"$wanted_uuid\""*)
                printf '%s\n' "$device"
                return 0
                ;;
        esac
    done
    return 1
}

resolve_label() {
    wanted_label="$1"
    for device in $($BB find /dev -type b 2>/dev/null); do
        metadata="$($BB blkid "$device" 2>/dev/null)"
        case "$metadata" in
            *"LABEL=\"$wanted_label\""*)
                printf '%s\n' "$device"
                return 0
                ;;
        esac
    done
    return 1
}

case "$BOOT_MODE" in
    live|installer-manual|installer-automatic)
        if [ "$ROOT_SEEN" -ne 0 ] || [ "$MEDIA_SEEN" -ne 1 ]; then
            fail "ISO boot requires exactly one kerynth.media=UUID=... parameter."
        fi
        case "$MEDIA" in
            UUID=*)
                MEDIA_UUID="${MEDIA#UUID=}"
                case "$MEDIA_UUID" in
                    ''|*[!A-Fa-f0-9-]*) fail "invalid Live media UUID." ;;
                esac
                ;;
            *)
                fail "Live media must be identified by UUID."
                ;;
        esac
        MEDIA_DEVICE="$(resolve_uuid "$MEDIA_UUID")" || MEDIA_DEVICE=
        MEDIA_MOUNTED=0
        if [ -n "$MEDIA_DEVICE" ] && [ -b "$MEDIA_DEVICE" ]; then
            if $BB mount -t iso9660 -o ro "$MEDIA_DEVICE" /media; then
                if [ -f /media/live/rootfs.squashfs ]; then
                    MEDIA_MOUNTED=1
                else
                    $BB umount /media 2>/dev/null || true
                fi
            fi
        fi
        if [ "$MEDIA_MOUNTED" -ne 1 ]; then
            for sys_device in /sys/class/block/*; do
                [ -e "$sys_device/removable" ] || continue
                removable="$($BB cat "$sys_device/removable" 2>/dev/null)"
                [ "$removable" = "1" ] || continue
                candidate="/dev/\${sys_device##*/}"
                [ -b "$candidate" ] || continue
                if $BB mount -t iso9660 -o ro "$candidate" /media; then
                    if [ -f /media/live/rootfs.squashfs ]; then
                        MEDIA_DEVICE="$candidate"
                        MEDIA_MOUNTED=1
                        break
                    fi
                    $BB umount /media 2>/dev/null || true
                fi
            done
        fi
        if [ "$MEDIA_MOUNTED" -ne 1 ]; then
            fail "Kerynth boot media was not found on the requested UUID or removable media."
        fi
        if ! $BB mount -t squashfs -o loop,ro /media/live/rootfs.squashfs /lower; then
            fail "cannot mount the Live SquashFS image read-only."
        fi
        if ! $BB mount -t tmpfs -o mode=0755,nosuid,nodev,size=256M tmpfs /overlay; then
            fail "cannot create the bounded Live overlay storage."
        fi
        if ! $BB mkdir -p /overlay/upper /overlay/work; then
            fail "cannot create the Live overlay directories."
        fi
        if ! $BB mount -t overlay overlay -o lowerdir=/lower,upperdir=/overlay/upper,workdir=/overlay/work /newroot; then
            fail "cannot create the writable Live root overlay."
        fi
        ;;
    installed)
        if [ "$ROOT_SEEN" -ne 1 ] || [ "$MEDIA_SEEN" -ne 0 ] || [ -z "$ROOT" ]; then
            fail "installed boot requires exactly one root= parameter."
        fi
        case "$ROOT" in
            UUID=*)
                ROOT_UUID="${ROOT#UUID=}"
                case "$ROOT_UUID" in
                    ''|*[!A-Fa-f0-9-]*) fail "invalid root UUID." ;;
                esac
                ROOT="$(resolve_uuid "$ROOT_UUID")" || ROOT=
                ;;
            LABEL=*)
                ROOT_LABEL="${ROOT#LABEL=}"
                case "$ROOT_LABEL" in
                    ''|*[!A-Za-z0-9._+-]*) fail "invalid root label." ;;
                esac
                ROOT="$(resolve_label "$ROOT_LABEL")" || ROOT=
                ;;
            /dev/*)
                case "$ROOT" in
                    *..*|*[!A-Za-z0-9_./+-]*) fail "invalid root device path." ;;
                esac
                ;;
            *)
                fail "root must be /dev/..., UUID=... or LABEL=..."
                ;;
        esac
        if [ -z "$ROOT" ] || [ ! -b "$ROOT" ]; then
            fail "root device not found."
        fi
        mount_args="-o ro"
        if [ "$ROOTFLAGS" = "rw" ]; then
            mount_args="-o rw"
        fi
        if [ -n "$ROOTFSTYPE" ]; then
            case "$ROOTFSTYPE" in
                *[!A-Za-z0-9_-]*) fail "invalid root filesystem type." ;;
            esac
            $BB mount $mount_args -t "$ROOTFSTYPE" "$ROOT" /newroot
        else
            $BB mount $mount_args "$ROOT" /newroot
        fi
        if [ $? -ne 0 ]; then
            fail "failed to mount the installed root filesystem."
        fi
        ;;
esac

for directory in dev proc sys run; do
    $BB mkdir -p "/newroot/$directory"
done

$BB mount --move /dev /newroot/dev
$BB mount --move /proc /newroot/proc
$BB mount --move /sys /newroot/sys

if ! $BB mount -t tmpfs -o mode=755,nosuid,nodev tmpfs /newroot/run; then
    fail "failed to create volatile /run."
fi

$BB mkdir -p /newroot/run/kerynth
if [ "$MEDIA_SEEN" -eq 1 ]; then
    $BB mkdir -p /newroot/run/kerynth-media
    $BB mount --move /media /newroot/run/kerynth-media
fi
if ! printf '%s\n' "$BOOT_MODE" > /newroot/run/kerynth/boot-mode; then
    fail "failed to publish boot mode."
fi

if [ -x /newroot/sbin/init ]; then
    exec $BB switch_root /newroot /sbin/init
fi

fail "/sbin/init is missing on the selected root."
