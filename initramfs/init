#!/bin/busybox sh

export PATH=/bin:/sbin
BB=/bin/busybox
CMDLINE="$($BB cat /proc/cmdline 2>/dev/null)"
if ! BOOT_MODE="$($BB sh /lib/kerynth-boot-mode "$CMDLINE" 2>/dev/null)"; then
    $BB echo "Kerynth: missing, duplicated, or unsupported boot mode."
    exec $BB sh
fi
ROOT=
ROOTFSTYPE=
ROOTFLAGS=
ROOTDELAY=0

for item in $CMDLINE; do
    case "$item" in
        root=*) ROOT="${item#root=}" ;;
        rootfstype=*) ROOTFSTYPE="${item#rootfstype=}" ;;
        rootflags=*) ROOTFLAGS="${item#rootflags=}" ;;
        rootdelay=*) ROOTDELAY="${item#rootdelay=}" ;;
    esac
done

case "$ROOTDELAY" in
    ''|*[!0-9]*) ROOTDELAY=0 ;;
esac
if [ "$ROOTDELAY" -gt 30 ]; then
    ROOTDELAY=30
fi

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev

if [ -x /bin/busybox ]; then
    $BB mdev -s 2>/dev/null || true
fi

if [ "$ROOTDELAY" -gt 0 ]; then
    $BB sleep "$ROOTDELAY"
fi

if [ -z "$ROOT" ]; then
    $BB echo "Kerynth: missing root= kernel parameter."
    exec $BB sh
fi

case "$ROOT" in
    UUID=*)
        wanted_uuid="${ROOT#UUID=}"
        case "$wanted_uuid" in
            ''|*[!A-Fa-f0-9-]*)
                $BB echo "Kerynth: invalid root UUID."
                exec $BB sh
                ;;
        esac
        ROOT=
        for device in $($BB find /dev -type b 2>/dev/null); do
            found_uuid="$($BB blkid -s UUID -o value "$device" 2>/dev/null)"
            if [ "$found_uuid" = "$wanted_uuid" ]; then
                ROOT="$device"
                break
            fi
        done
        ;;
    LABEL=*)
        wanted_label="${ROOT#LABEL=}"
        case "$wanted_label" in
            ''|*[!A-Za-z0-9._+-]*)
                $BB echo "Kerynth: invalid root label."
                exec $BB sh
                ;;
        esac
        ROOT=
        for device in $($BB find /dev -type b 2>/dev/null); do
            found_label="$($BB blkid -s LABEL -o value "$device" 2>/dev/null)"
            if [ "$found_label" = "$wanted_label" ]; then
                ROOT="$device"
                break
            fi
        done
        ;;
    /dev/*)
        case "$ROOT" in
            *..*|*[!A-Za-z0-9_./+-]*)
                $BB echo "Kerynth: invalid root device path."
                exec $BB sh
                ;;
        esac
        ;;
    *)
        $BB echo "Kerynth: root must be /dev/..., UUID=... or LABEL=..."
        exec $BB sh
        ;;
esac

if [ -z "$ROOT" ] || [ ! -b "$ROOT" ]; then
    $BB echo "Kerynth: root device not found: $ROOT"
    exec $BB sh
fi

$BB mkdir -p /newroot
mount_args="-o ro"
if [ "$ROOTFLAGS" = "rw" ]; then
    mount_args="-o rw"
fi

if [ -n "$ROOTFSTYPE" ]; then
    $BB mount $mount_args -t "$ROOTFSTYPE" "$ROOT" /newroot
else
    $BB mount $mount_args "$ROOT" /newroot
fi

if [ $? -ne 0 ]; then
    $BB echo "Kerynth: failed to mount root filesystem: $ROOT"
    exec $BB sh
fi

for directory in dev proc sys run; do
    $BB mkdir -p "/newroot/$directory"
done

$BB mount --move /dev /newroot/dev
$BB mount --move /proc /newroot/proc
$BB mount --move /sys /newroot/sys

if ! $BB mount -t tmpfs -o mode=755,nosuid,nodev tmpfs /newroot/run; then
    $BB echo "Kerynth: failed to create volatile /run."
    exec $BB sh
fi

$BB mkdir -p /newroot/run/kerynth
if ! printf '%s\n' "$BOOT_MODE" > /newroot/run/kerynth/boot-mode; then
    $BB echo "Kerynth: failed to publish boot mode."
    exec $BB sh
fi

if [ -x /newroot/sbin/init ]; then
    exec $BB switch_root /newroot /sbin/init
fi

$BB echo "Kerynth: /sbin/init is missing on the selected root."
exec $BB sh
