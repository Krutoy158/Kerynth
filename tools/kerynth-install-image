#!/usr/bin/env python3
import argparse
import importlib.util
import json
import os
import shutil
import stat
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[1]
LAYOUT_PATH = PROJECT_ROOT / "tools" / "kerynth-install-layout"
SPEC = importlib.util.spec_from_loader(
    "kerynth_install_layout_module",
    SourceFileLoader("kerynth_install_layout_module", str(LAYOUT_PATH)),
)
LAYOUT = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(LAYOUT)


class ImageInstallError(Exception):
    pass


def fail(message):
    raise ImageInstallError(message)


def validate_image(image_path, expected_size):
    path = Path(image_path)
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ImageInstallError("cannot inspect disk image: " + str(exc)) from exc

    if not stat.S_ISREG(metadata.st_mode):
        fail("target must be a regular disk image file; block devices are not supported")
    if path.is_symlink():
        fail("symbolic-link disk images are not supported")
    if metadata.st_nlink != 1:
        fail("disk image must not have additional hard links")
    if path.suffix.lower() not in (".img", ".raw"):
        fail("disk image filename must end in .img or .raw")
    if metadata.st_size != expected_size:
        fail("disk image size must exactly match the requested layout size")
    if not os.access(path, os.W_OK):
        fail("disk image is not writable")
    return path.resolve(strict=True)


def validate_plan(plan):
    required_fields = {
        "format_version",
        "partition_table",
        "mode",
        "disk_bytes",
        "geometry",
        "partitions",
        "sfdisk_script",
        "writes_performed",
    }
    if type(plan) is not dict or set(plan) != required_fields:
        fail("layout plan fields do not match the supported schema")
    if type(plan["format_version"]) is not int or plan["format_version"] != 1:
        fail("unsupported layout plan version")
    if plan["partition_table"] != "gpt":
        fail("layout plan must use GPT")
    if plan["writes_performed"] is not False:
        fail("layout plan must be a no-write plan generated by kerynth-install-layout")
    if type(plan["disk_bytes"]) is not int:
        fail("layout plan disk size must be an integer")
    if not isinstance(plan["geometry"], dict):
        fail("layout plan geometry must be an object")
    geometry_fields = {
        "total_sectors",
        "alignment_sectors",
        "last_usable_sector",
        "sector_size",
    }
    geometry = plan["geometry"]
    if set(geometry) != geometry_fields:
        fail("layout plan geometry fields do not match the supported schema")
    if any(type(geometry[field]) is not int for field in geometry_fields):
        fail("layout plan geometry values must be integers")
    sector_size = geometry["sector_size"]
    try:
        expected_geometry = LAYOUT.validate_geometry(plan["disk_bytes"], sector_size)
    except LAYOUT.LayoutError as exc:
        raise ImageInstallError("invalid layout plan geometry: " + str(exc)) from exc
    if geometry != expected_geometry:
        fail("layout plan geometry is inconsistent with its disk size")
    mode = plan["mode"]
    if mode not in ("automatic", "manual"):
        fail("layout plan mode must be automatic or manual")
    partitions = plan["partitions"]
    if not isinstance(partitions, list) or len(partitions) != 2:
        fail("layout plan must contain exactly two partitions")
    layout = None
    if mode == "manual":
        alignment = expected_geometry["alignment_sectors"]
        manual_partitions = []
        expected_partition_fields = {
            "number",
            "role",
            "start_sector",
            "size_sectors",
            "end_sector",
            "type_guid",
            "filesystem",
            "mountpoint",
            "name",
        }
        for item in partitions:
            if type(item) is not dict or set(item) != expected_partition_fields:
                fail("manual layout partition fields do not match the supported schema")
            if type(item["start_sector"]) is not int or type(item["size_sectors"]) is not int:
                fail("manual layout partition boundaries must be integers")
            if item["start_sector"] % alignment or item["size_sectors"] % alignment:
                fail("manual layout partition boundaries must be aligned to 1 MiB")
            manual_partitions.append({
                "role": item["role"],
                "start_mib": item["start_sector"] // alignment,
                "size_mib": item["size_sectors"] // alignment,
            })
        layout = {"partitions": manual_partitions}
    try:
        expected_plan = LAYOUT.build_plan(plan["disk_bytes"], sector_size, mode, layout)
        supplied = json.dumps(plan, sort_keys=True, separators=(",", ":"), allow_nan=False)
        expected = json.dumps(expected_plan, sort_keys=True, separators=(",", ":"), allow_nan=False)
    except (LAYOUT.LayoutError, TypeError, ValueError) as exc:
        raise ImageInstallError("cannot validate layout plan: " + str(exc)) from exc
    if supplied != expected:
        fail("layout plan does not match the canonical partition plan")
    return expected_plan


def run_sfdisk(command, input_text=None):
    try:
        return subprocess.run(
            command,
            input=input_text,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise ImageInstallError("cannot execute sfdisk: " + str(exc)) from exc


def verify_partition_table(image_path, plan, sfdisk_binary):
    result = run_sfdisk([sfdisk_binary, "--json", str(image_path)])
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        fail("sfdisk could not read back the partition table: " + detail[-2000:])

    try:
        payload = json.loads(result.stdout)
        table = payload["partitiontable"]
        actual = table["partitions"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise ImageInstallError("sfdisk returned malformed partition-table JSON") from exc

    if table.get("label") != "gpt":
        fail("written partition table is not GPT")
    if table.get("sectorsize", plan["geometry"]["sector_size"]) != plan["geometry"]["sector_size"]:
        fail("written partition table has an unexpected logical sector size")
    expected = plan["partitions"]
    if len(actual) != len(expected):
        fail("written partition count does not match the layout plan")

    for found, wanted in zip(actual, expected):
        if found.get("start") != wanted["start_sector"]:
            fail("written partition start does not match the layout plan")
        if found.get("size") != wanted["size_sectors"]:
            fail("written partition size does not match the layout plan")
        if str(found.get("type", "")).casefold() != wanted["type_guid"].casefold():
            fail("written partition type does not match the layout plan")
        if found.get("name") != wanted["name"]:
            fail("written partition name does not match the layout plan")

    return {
        "label": "gpt",
        "sector_size": table.get("sectorsize", plan["geometry"]["sector_size"]),
        "partition_count": len(actual),
    }


def apply_plan_to_image(image_path, plan, sfdisk_binary=None, confirm=False):
    if not confirm:
        fail("explicit confirmation is required before writing the disk image")
    plan = validate_plan(plan)
    image = validate_image(image_path, plan["disk_bytes"])
    binary = sfdisk_binary or shutil.which("sfdisk")
    if not binary:
        fail("sfdisk is required to write a GPT layout to a disk image")

    command = [
        binary,
        "--no-reread",
        "--no-tell-kernel",
        "--wipe=never",
        "--wipe-partitions=never",
        str(image),
    ]
    result = run_sfdisk(command, plan["sfdisk_script"])
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        fail("sfdisk failed while writing the disk image: " + detail[-3000:])

    verification = verify_partition_table(image, plan, binary)
    return {
        "image": str(image),
        "disk_bytes": plan["disk_bytes"],
        "target_type": "regular_file",
        "writes_performed": True,
        "verified": True,
        **verification,
    }


def main(argv=None):
    parser = argparse.ArgumentParser(prog="kerynth-install-image")
    parser.add_argument("--image", required=True)
    parser.add_argument("--disk-bytes", required=True, type=int)
    parser.add_argument("--sector-size", type=int, choices=(512, 4096), default=512)
    parser.add_argument("--mode", required=True, choices=("automatic", "manual"))
    parser.add_argument("--layout-json")
    parser.add_argument("--sfdisk")
    parser.add_argument("--confirm-overwrite-image", action="store_true", required=True)
    args = parser.parse_args(argv)

    try:
        layout = LAYOUT.load_layout(args.layout_json) if args.layout_json else None
        plan = LAYOUT.build_plan(args.disk_bytes, args.sector_size, args.mode, layout)
        result = apply_plan_to_image(args.image, plan, args.sfdisk, args.confirm_overwrite_image)
        print(json.dumps(result, sort_keys=True, indent=2))
        return 0
    except (ImageInstallError, LAYOUT.LayoutError, OSError, ValueError) as exc:
        print("kerynth-install-image: error: " + str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
