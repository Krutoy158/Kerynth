#!/usr/bin/env python3
import argparse
import hashlib
import io
import json
import os
import re
import stat
import sys
import tarfile
from pathlib import Path, PurePosixPath
from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey

DOMAIN=b"KERYNTH-KER-V1\0"
FIELDS={"format_version","name","version","architecture","description","dependencies","conflicts","payload_sha256","signing_key_id"}
OUTER=("manifest.json","payload.tar","signature.ed25519")
NAME=re.compile(r"^[a-z0-9][a-z0-9+_.-]*$")
VERSION=re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+:~_-]*$")
HEX=re.compile(r"^[0-9a-f]{64}$")

class PackageError(Exception): pass

def fail(message): raise PackageError(message)

def canonical(value):
    return json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(",",":"),allow_nan=False).encode("utf-8")

def pairs_hook(pairs):
    result={}
    for key,value in pairs:
        if key in result: fail("duplicate manifest key: "+key)
        result[key]=value
    return result

def parse_manifest(raw):
    if raw.startswith(b"\xef\xbb\xbf"): fail("manifest must not contain a UTF-8 BOM")
    try: value=json.loads(raw.decode("utf-8"),object_pairs_hook=pairs_hook,parse_constant=lambda x:fail("invalid JSON constant: "+x))
    except (UnicodeDecodeError,json.JSONDecodeError) as exc: raise PackageError("invalid manifest JSON: "+str(exc)) from exc
    if not isinstance(value,dict): fail("manifest must be a JSON object")
    if set(value)!=FIELDS: fail("manifest fields mismatch")
    if canonical(value)!=raw: fail("manifest is not canonical JSON")
    if type(value["format_version"]) is not int or value["format_version"]!=1: fail("unsupported format_version")
    if not isinstance(value["name"],str) or not NAME.fullmatch(value["name"]): fail("invalid package name")
    if not isinstance(value["version"],str) or not VERSION.fullmatch(value["version"]): fail("invalid package version")
    if value["architecture"] not in ("x86_64","noarch"): fail("unsupported architecture")
    if not isinstance(value["description"],str) or not value["description"]: fail("description must be non-empty")
    if not isinstance(value["signing_key_id"],str) or not value["signing_key_id"]: fail("signing_key_id must be non-empty")
    if not isinstance(value["payload_sha256"],str) or not HEX.fullmatch(value["payload_sha256"]): fail("invalid payload_sha256")
    for field in ("dependencies","conflicts"):
        if not isinstance(value[field],list): fail(field+" must be an array")
        for entry in value[field]:
            if not isinstance(entry,dict) or set(entry) not in ({"name"},{"name","version"}): fail("invalid "+field+" entry")
            if not isinstance(entry["name"],str) or not NAME.fullmatch(entry["name"]): fail("invalid "+field+" name")
            if "version" in entry and not isinstance(entry["version"],str): fail("invalid "+field+" version")
    return value

def safe_path(name):
    if not isinstance(name,str) or not name or "\\" in name: fail("invalid archive path: "+repr(name))
    path=PurePosixPath(name)
    if path.is_absolute() or any(part in ("",".","..") for part in name.split("/")) or str(path)!=name: fail("unsafe archive path: "+name)
    return name

def open_tar(data,label):
    try:
        archive=tarfile.open(fileobj=io.BytesIO(data),mode="r:")
        return archive,archive.getmembers()
    except (tarfile.TarError,OSError) as exc: raise PackageError("invalid "+label+" archive: "+str(exc)) from exc

def validate_payload(payload):
    archive,members=open_tar(payload,"payload")
    try:
        seen=set()
        for member in members:
            name=safe_path(member.name)
            if name in seen: fail("duplicate payload path: "+name)
            seen.add(name)
            if member.type not in (tarfile.REGTYPE,tarfile.AREGTYPE,tarfile.DIRTYPE): fail("unsupported payload entry type: "+name)
            if member.pax_headers: fail("PAX metadata is not supported: "+name)
            if member.mode & (stat.S_ISUID|stat.S_ISGID) or member.mode & ~0o777: fail("unsafe permissions: "+name)
            if member.uid!=0 or member.gid!=0: fail("payload ownership must be normalized: "+name)
            if member.type==tarfile.DIRTYPE and member.size!=0: fail("directory has data: "+name)
    finally: archive.close()
    kinds = {member.name: member.type for member in members}
    for name in kinds:
        parent = PurePosixPath(name).parent
        while str(parent) != ".":
            parent_name = parent.as_posix()
            if parent_name in kinds and kinds[parent_name] != tarfile.DIRTYPE:
                fail("payload path is nested below a regular file: " + name)
            parent = parent.parent
    return len(members)

def make_payload(source):
    root=Path(source).resolve(strict=True)
    if not root.is_dir(): fail("payload source must be a directory")
    output=io.BytesIO()
    with tarfile.open(fileobj=output,mode="w",format=tarfile.USTAR_FORMAT) as archive:
        for path in sorted(root.rglob("*"),key=lambda p:p.relative_to(root).as_posix()):
            name=safe_path(path.relative_to(root).as_posix())
            info=path.lstat()
            if stat.S_ISLNK(info.st_mode): fail("symbolic links are not allowed: "+name)
            if stat.S_ISDIR(info.st_mode):
                member=tarfile.TarInfo(name); member.type=tarfile.DIRTYPE; member.mode=stat.S_IMODE(info.st_mode)&0o777
                member.uid=member.gid=member.mtime=0; archive.addfile(member)
            elif stat.S_ISREG(info.st_mode):
                if info.st_mode&(stat.S_ISUID|stat.S_ISGID): fail("setuid/setgid mode is not allowed: "+name)
                member=tarfile.TarInfo(name); member.size=info.st_size; member.mode=stat.S_IMODE(info.st_mode)&0o777
                member.uid=member.gid=member.mtime=0
                with path.open("rb") as stream: archive.addfile(member,stream)
            else: fail("unsupported filesystem entry: "+name)
    payload=output.getvalue(); validate_payload(payload); return payload

def private_key(path):
    try: key=serialization.load_pem_private_key(Path(path).read_bytes(),password=None)
    except (OSError,ValueError,TypeError) as exc: raise PackageError("cannot load private key: "+str(exc)) from exc
    if not isinstance(key,Ed25519PrivateKey): fail("private key must be Ed25519")
    return key

def parse_relations(values):
    result = []
    for value in values:
        parts = value.split("=", 1)
        name = parts[0]
        if not NAME.fullmatch(name):
            fail("invalid package relation: " + value)
        entry = {"name": name}
        if len(parts) == 2:
            if not VERSION.fullmatch(parts[1]):
                fail("invalid package relation version: " + value)
            entry["version"] = parts[1]
        result.append(entry)
    if len({item["name"] for item in result}) != len(result):
        fail("duplicate package relation")
    return result

def build(args):
    payload=make_payload(args.payload_dir); digest=hashlib.sha256(payload).digest()
    manifest={"format_version":1,"name":args.name,"version":args.version,"architecture":args.architecture,"description":args.description,"dependencies":parse_relations(args.depends),"conflicts":parse_relations(args.conflicts),"payload_sha256":digest.hex(),"signing_key_id":args.key_id}
    raw=canonical(manifest); parse_manifest(raw)
    signature=private_key(args.private_key).sign(DOMAIN+raw+digest)
    output=Path(args.output); output.parent.mkdir(parents=True,exist_ok=True); temporary=output.with_name(output.name+".tmp")
    try:
        with tarfile.open(temporary,mode="w",format=tarfile.USTAR_FORMAT) as archive:
            for name,data in zip(OUTER,(raw,payload,signature)):
                info=tarfile.TarInfo(name); info.size=len(data); info.mode=0o644; info.uid=info.gid=info.mtime=0
                archive.addfile(info,io.BytesIO(data))
        os.replace(temporary,output)
    finally: temporary.unlink(missing_ok=True)
    print("Created "+str(output))

def keyring(path):
    try: data=json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError) as exc: raise PackageError("cannot read keyring: "+str(exc)) from exc
    if not isinstance(data,dict): fail("keyring must be a JSON object")
    result={}
    for key_id,encoded in data.items():
        if not isinstance(key_id,str) or not isinstance(encoded,str): fail("invalid keyring entry")
        try:
            raw=bytes.fromhex(encoded)
            if len(raw)!=32: fail("invalid Ed25519 public key length: "+key_id)
            result[key_id]=Ed25519PublicKey.from_public_bytes(raw)
        except ValueError as exc: raise PackageError("invalid public key: "+key_id) from exc
    return result

def read_verified_package(package_path, keyring_path):
    try:
        outer, members = open_tar(Path(package_path).read_bytes(), "package")
    except OSError as exc:
        raise PackageError("cannot read package: " + str(exc)) from exc
    try:
        if [member.name for member in members] != list(OUTER):
            fail("outer archive must contain exactly three required members in order")
        data = {}
        for member in members:
            if member.type not in (tarfile.REGTYPE, tarfile.AREGTYPE) or member.pax_headers:
                fail("outer members must be plain regular files")
            if member.uid != 0 or member.gid != 0 or member.mode != 0o644:
                fail("outer package metadata is not normalized")
            stream = outer.extractfile(member)
            if stream is None:
                fail("cannot read outer member: " + member.name)
            data[member.name] = stream.read()
    finally:
        outer.close()
    raw = data["manifest.json"]
    manifest = parse_manifest(raw)
    payload = data["payload.tar"]
    digest = hashlib.sha256(payload).digest()
    if digest.hex() != manifest["payload_sha256"]:
        fail("payload SHA-256 mismatch")
    public = keyring(keyring_path).get(manifest["signing_key_id"])
    if public is None:
        fail("untrusted signing key: " + manifest["signing_key_id"])
    signature = data["signature.ed25519"]
    if len(signature) != 64:
        fail("Ed25519 signature must be exactly 64 bytes")
    try:
        public.verify(signature, DOMAIN + raw + digest)
    except InvalidSignature as exc:
        raise PackageError("Ed25519 signature verification failed") from exc
    validate_payload(payload)
    return manifest, payload

def verify(args):
    manifest, payload = read_verified_package(args.package, args.keyring)
    archive, members = open_tar(payload, "payload")
    archive.close()
    print("Verified {} {} ({})".format(manifest["name"], manifest["version"], manifest["architecture"]))
    print("Payload entries: " + str(len(members)))

def target_root(value):
    raw = Path(value)
    if raw.is_symlink():
        fail("target root must not be a symbolic link")
    root = raw.resolve()
    project = Path(__file__).resolve().parents[1]
    allowed = (project / ".kerynth-work" / "targets").resolve()
    if not root.is_relative_to(allowed) or root == allowed:
        fail("package operations are restricted to a disposable root below .kerynth-work/targets")
    if root.exists() and not root.is_dir():
        fail("target root must be a directory")
    root.mkdir(parents=True, exist_ok=True)
    if root.is_symlink():
        fail("target root must not be a symbolic link")
    return root

def safe_target_path(root, relative, allow_missing=True):
    safe_path(relative)
    current = root
    for part in PurePosixPath(relative).parts:
        current = current / part
        if current.is_symlink():
            fail("target path contains a symbolic link: " + relative)
        if current.exists() and not (current.is_dir() or current.is_file()):
            fail("target path contains a special filesystem entry: " + relative)
    parent = (root / PurePosixPath(relative)).parent
    if not parent.resolve().is_relative_to(root):
        fail("target path escapes its root: " + relative)
    if not allow_missing and not (root / PurePosixPath(relative)).exists():
        fail("installed package file is missing: " + relative)
    return root / PurePosixPath(relative)

def package_database(root):
    database = safe_target_path(root, "var/lib/kerynth/packages")
    database.mkdir(parents=True, exist_ok=True)
    if not database.resolve().is_relative_to(root):
        fail("package database escapes target root")
    return database

def read_installed(root):
    database = package_database(root)
    installed = {}
    for record in sorted(database.glob("*.json")):
        if record.is_symlink() or not record.is_file():
            fail("package database contains a non-regular entry: " + record.name)
        try:
            value = json.loads(record.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise PackageError("cannot read installed package record: " + record.name) from exc
        if not isinstance(value, dict) or value.get("name") != record.stem or not isinstance(value.get("version"), str):
            fail("invalid installed package record: " + record.name)
        installed[record.stem] = value
    return installed

def version_matches(installed, requested):
    return requested is None or installed == requested

def validate_relations(manifest, installed):
    name = manifest["name"]
    if name in installed:
        fail("package is already installed: " + name)
    if manifest["architecture"] not in ("noarch", "x86_64"):
        fail("package architecture does not match this target")
    for dependency in manifest["dependencies"]:
        item = installed.get(dependency["name"])
        if item is None:
            fail("missing dependency: " + dependency["name"])
        if not version_matches(item["version"], dependency.get("version")):
            fail("dependency version mismatch: " + dependency["name"])
    for conflict in manifest["conflicts"]:
        item = installed.get(conflict["name"])
        if item is not None and version_matches(item["version"], conflict.get("version")):
            fail("package conflicts with installed package: " + conflict["name"])
    for installed_name, item in installed.items():
        for conflict in item.get("conflicts", []):
            if conflict.get("name") == name and version_matches(manifest["version"], conflict.get("version")):
                fail("installed package {} conflicts with {}".format(installed_name, name))

def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    if temporary.exists() or temporary.is_symlink():
        fail("temporary package database file already exists: " + temporary.name)
    try:
        with temporary.open("x", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)

def install(args):
    root = target_root(args.root)
    manifest, payload = read_verified_package(args.package, args.keyring)
    installed = read_installed(root)
    validate_relations(manifest, installed)
    archive, members = open_tar(payload, "payload")
    entries = []
    created_files = []
    created_dirs = []
    try:
        for member in members:
            relative = safe_path(member.name)
            target = safe_target_path(root, relative)
            if member.isdir():
                if target.exists() and not target.is_dir():
                    fail("directory path collides with an existing file: " + relative)
                entries.append((member, relative, target))
            else:
                if target.exists():
                    fail("package file would overwrite an existing path: " + relative)
                entries.append((member, relative, target))
        for member, relative, target in entries:
            if member.isdir():
                if not target.exists():
                    parent = target.parent
                    missing = []
                    while parent != root and not parent.exists():
                        missing.append(parent)
                        parent = parent.parent
                    for directory in reversed(missing):
                        directory.mkdir()
                        created_dirs.append(directory)
                    target.mkdir()
                    created_dirs.append(target)
                os.chmod(target, member.mode & 0o777)
                continue
            parent = target.parent
            missing = []
            while parent != root and not parent.exists():
                missing.append(parent)
                parent = parent.parent
            for directory in reversed(missing):
                directory.mkdir()
                created_dirs.append(directory)
            stream = archive.extractfile(member)
            if stream is None:
                fail("cannot read package payload: " + relative)
            temporary = target.with_name(target.name + ".ker-tmp")
            if temporary.exists() or temporary.is_symlink():
                fail("temporary package file already exists: " + relative)
            digest = hashlib.sha256()
            try:
                with stream, temporary.open("xb") as output:
                    while True:
                        chunk = stream.read(1024 * 1024)
                        if not chunk:
                            break
                        digest.update(chunk)
                        output.write(chunk)
                    output.flush()
                    os.fsync(output.fileno())
                os.chmod(temporary, member.mode & 0o777)
                os.replace(temporary, target)
            finally:
                temporary.unlink(missing_ok=True)
            created_files.append({"path": relative, "sha256": digest.hexdigest(), "mode": member.mode & 0o777})
        database = package_database(root)
        record = {
            "format_version": 1,
            "name": manifest["name"],
            "version": manifest["version"],
            "architecture": manifest["architecture"],
            "description": manifest["description"],
            "dependencies": manifest["dependencies"],
            "conflicts": manifest["conflicts"],
            "files": created_files,
            "directories": [path.relative_to(root).as_posix() for path in created_dirs],
            "signing_key_id": manifest["signing_key_id"]
        }
        atomic_json(database / (manifest["name"] + ".json"), record)
    except Exception:
        for item in reversed(created_files):
            path = root / PurePosixPath(item["path"])
            if path.is_file() and not path.is_symlink():
                path.unlink()
        for directory in reversed(created_dirs):
            try:
                directory.rmdir()
            except OSError:
                pass
        raise
    finally:
        archive.close()
    print("Installed {} {} into {}".format(manifest["name"], manifest["version"], root))

def remove(args):
    root = target_root(args.root)
    installed = read_installed(root)
    name = args.name
    record = installed.get(name)
    if record is None:
        fail("package is not installed: " + name)
    dependents = []
    for other_name, other in installed.items():
        if other_name == name:
            continue
        for dependency in other.get("dependencies", []):
            if dependency["name"] == name:
                dependents.append(other_name)
    if dependents:
        fail("package is required by installed packages: " + ", ".join(sorted(dependents)))
    files = record.get("files")
    directories = record.get("directories")
    if not isinstance(files, list) or not isinstance(directories, list):
        fail("installed package record has invalid ownership data")
    verified = []
    for item in files:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not isinstance(item.get("sha256"), str):
            fail("installed file record is invalid")
        path = safe_target_path(root, item["path"], allow_missing=False)
        if not path.is_file() or path.is_symlink():
            fail("installed path is no longer a regular file: " + item["path"])
        if hashlib.sha256(path.read_bytes()).hexdigest() != item["sha256"]:
            fail("installed file was modified; refusing to remove: " + item["path"])
        verified.append(path)
    directory_paths = [safe_target_path(root, item) for item in directories]
    for path in verified:
        path.unlink()
    for path in reversed(directory_paths):
        try:
            path.rmdir()
        except OSError:
            pass
    record_path = package_database(root) / (name + ".json")
    record_path.unlink()
    print("Removed " + name)

def list_installed(args):
    root = target_root(args.root)
    installed = read_installed(root)
    if not installed:
        print("No packages installed.")
        return
    for name, record in sorted(installed.items()):
        print("{} {} ({})".format(name, record["version"], record.get("architecture", "unknown")))

def main(argv=None):
    parser=argparse.ArgumentParser(prog="ker-package"); commands=parser.add_subparsers(dest="command",required=True)
    b=commands.add_parser("build"); b.add_argument("--payload-dir",required=True); b.add_argument("--name",required=True); b.add_argument("--version",required=True); b.add_argument("--architecture",choices=("x86_64","noarch"),default="x86_64"); b.add_argument("--description",required=True); b.add_argument("--key-id",required=True); b.add_argument("--private-key",required=True); b.add_argument("--depends",action="append",default=[]); b.add_argument("--conflicts",action="append",default=[]); b.add_argument("--output",required=True); b.set_defaults(handler=build)
    v=commands.add_parser("verify"); v.add_argument("package"); v.add_argument("--keyring",required=True); v.set_defaults(handler=verify)
    i=commands.add_parser("install"); i.add_argument("package"); i.add_argument("--keyring",required=True); i.add_argument("--root",required=True); i.set_defaults(handler=install)
    r=commands.add_parser("remove"); r.add_argument("name"); r.add_argument("--root",required=True); r.set_defaults(handler=remove)
    l=commands.add_parser("list"); l.add_argument("--root",required=True); l.set_defaults(handler=list_installed)
    args=parser.parse_args(argv)
    try: args.handler(args); return 0
    except PackageError as exc: print("ker-package: error: "+str(exc),file=sys.stderr); return 1

if __name__=="__main__": raise SystemExit(main())
