#!/usr/bin/env python3
import argparse
import gzip
import os
import stat
import sys
from pathlib import Path, PurePosixPath

class InitramfsError(Exception):
    pass

def fail(message):
    raise InitramfsError(message)

def cpio_record(name, mode, data, inode):
    encoded = name.encode("utf-8") + b"\0"
    fields = (
        inode, mode, 0, 0, 1, 0, len(data), 0, 0, 0, 0,
        len(encoded), 0,
    )
    header = b"070701" + b"".join(f"{value:08x}".encode("ascii") for value in fields)
    record = header + encoded
    record += b"\0" * ((-len(record)) % 4)
    record += data
    record += b"\0" * ((-len(record)) % 4)
    return record

def collect(root):
    root = Path(root).resolve(strict=True)
    if not root.is_dir():
        fail("staging root must be a directory")
    init = root / "init"
    busybox = root / "bin" / "busybox"
    for required in (init, busybox):
        try:
            info = required.lstat()
        except OSError as exc:
            fail(f"required file missing: /{required.relative_to(root)}")
        if not stat.S_ISREG(info.st_mode) or not info.st_mode & 0o111:
            fail(f"required file must be a regular executable: /{required.relative_to(root)}")

    entries = []
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix()
        if not relative or relative.startswith("/") or any(part in ("", ".", "..") for part in relative.split("/")):
            fail("unsafe staging path")
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            fail(f"symbolic links are not supported: /{relative}")
        if stat.S_ISDIR(info.st_mode):
            mode = stat.S_IFDIR | (stat.S_IMODE(info.st_mode) & 0o777)
            data = b""
        elif stat.S_ISREG(info.st_mode):
            mode = stat.S_IFREG | (stat.S_IMODE(info.st_mode) & 0o777)
            data = path.read_bytes()
        else:
            fail(f"unsupported filesystem entry: /{relative}")
        entries.append((relative, mode, data))
    return entries

def build(root, output):
    entries = collect(root)
    archive = bytearray()
    for inode, (name, mode, data) in enumerate(entries, 1):
        archive.extend(cpio_record(name, mode, data, inode))
    archive.extend(cpio_record("TRAILER!!!", 0, b"", len(entries) + 1))
    output = Path(output)
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary = output.with_name(output.name + ".tmp")
    try:
        with temporary.open("wb") as raw:
            with gzip.GzipFile(fileobj=raw, mode="wb", filename="", mtime=0, compresslevel=9) as stream:
                stream.write(archive)
        os.replace(temporary, output)
    finally:
        temporary.unlink(missing_ok=True)
    print(f"Created {output} ({len(entries)} entries)")

def main(argv=None):
    parser = argparse.ArgumentParser(prog="kerynth-initramfs")
    parser.add_argument("--root", required=True)
    parser.add_argument("--output", required=True)
    args = parser.parse_args(argv)
    try:
        build(args.root, args.output)
        return 0
    except (InitramfsError, OSError) as exc:
        print(f"kerynth-initramfs: error: {exc}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
